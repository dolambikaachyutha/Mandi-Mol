# ---------------------------------------------------------------------------
# Gnani AI — copy this file to `.env` and fill in your own key.
# `.env` is gitignored; never commit a real key.
# ---------------------------------------------------------------------------
GNANI_API_KEY="your_gnani_api_key_here"

# Speech API base URL (Prisma STT + Timbre TTS)
GNANI_BASE_URL="https://api.vachana.ai"

# Prisma speech-to-text model: prisma-v3.0 (multilingual / code-mix) or prisma-v2.5
GNANI_STT_MODEL="prisma-v3.0"

# Timbre text-to-speech model and the male trader voice per language.
# Timbre v3.0 voices speak every supported language, so Lalaji stays consistent.
GNANI_TTS_MODEL="timbre-v3.0"
GNANI_TTS_VOICE_HINGLISH="Avinash"
GNANI_TTS_VOICE_HINDI="Avinash"
GNANI_TTS_VOICE_TELUGU="Avinash"
GNANI_TTS_VOICE_ENGLISH="Avinash"

# Optional: Evon reasoning (Gnani provisions access on request).
# Without it the server uses the deterministic trader brain.
# EVON_ENDPOINT="https://api.vachana.ai/v1/chat/completions"
# EVON_API_KEY=""
# EVON_MODEL="gnani-evon-v3.3"

# true = disable live Gnani speech services for local UI work
VITE_MOCK="false"
